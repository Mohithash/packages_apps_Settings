<resources>

    <!-- Kill switches for the BestROM homepage restyle. Overridable from a device overlay. -->
    <bool name="config_bestrom_homepage_style">true</bool>
    <bool name="config_bestrom_homepage_device_card">true</bool>

    <!-- Surfaces follow the SettingsLib material tokens so Settings keeps tracking the ROM's
         monochrome ramp and the pure black theme toggle. -->
    <color name="bestrom_page_bg">@color/settingslib_materialColorSurfaceContainerLow</color>
    <color name="bestrom_row_bg">@color/settingslib_materialColorSurfaceContainer</color>
    <color name="bestrom_row_bg_selected">@color/settingslib_materialColorSurfaceContainerHighest</color>
    <color name="bestrom_card_bg">@color/settingslib_materialColorSurfaceContainerHigh</color>
    <color name="bestrom_text_primary">@color/settingslib_text_color_primary</color>
    <color name="bestrom_text_secondary">@color/settingslib_text_color_secondary</color>

    <!-- Sub-page rows sit on the sub-page window background, which is the same token as
         bestrom_row_bg, so they need their own fill one step up the ramp. -->
    <color name="bestrom_subpage_row_bg">@color/settingslib_materialColorSurfaceContainerHigh</color>

    <!-- The design's greys. Light mode keeps the material tokens, which stay legible on a
         near-white surface; values-night carries the design's own values. -->
    <color name="bestrom_glyph_ring">@color/settingslib_materialColorOutlineVariant</color>
    <color name="bestrom_row_value">@color/settingslib_materialColorOnSurfaceVariant</color>
    <color name="bestrom_text_hint">@color/settingslib_materialColorOnSurfaceVariant</color>
    <color name="bestrom_text_muted">#6A6A6A</color>
    <color name="bestrom_avatar_bg">#E0E0E0</color>
    <color name="bestrom_avatar_dot">#9A9A9A</color>

    <!-- Homepage rows -->
    <dimen name="bestrom_row_corner_radius">22dp</dimen>
    <dimen name="bestrom_row_gap_half">3dp</dimen>
    <dimen name="bestrom_row_min_height">56dp</dimen>
    <dimen name="bestrom_row_text_padding_vertical">11dp</dimen>
    <dimen name="bestrom_row_content_inset">34dp</dimen>
    <dimen name="bestrom_row_text_gap">14dp</dimen>
    <dimen name="bestrom_glyph_size">36dp</dimen>
    <dimen name="bestrom_glyph_text_min_size">8dp</dimen>
    <dimen name="bestrom_glyph_ring_stroke">1.5dp</dimen>
    <dimen name="bestrom_glyph_text_size">15dp</dimen>
    <dimen name="bestrom_row_title_text_size">15sp</dimen>
    <dimen name="bestrom_row_summary_text_size">12sp</dimen>
    <dimen name="bestrom_row_value_text_size">13sp</dimen>

    <!-- Search pill -->
    <dimen name="bestrom_search_bar_height">52dp</dimen>
    <dimen name="bestrom_search_bar_corner_radius">26dp</dimen>
    <dimen name="bestrom_search_bar_text_size">15sp</dimen>
    <dimen name="bestrom_search_bar_padding">20dp</dimen>
    <dimen name="bestrom_search_bar_gap">12dp</dimen>
    <dimen name="bestrom_search_dot_size">16dp</dimen>
    <dimen name="bestrom_search_dot_stroke">2dp</dimen>

    <!-- Header -->
    <dimen name="bestrom_eyebrow_text_size">12sp</dimen>
    <dimen name="bestrom_page_title_text_size">44dp</dimen>
    <dimen name="bestrom_page_title_min_text_size">20dp</dimen>
    <dimen name="bestrom_header_margin_start">8dp</dimen>
    <dimen name="bestrom_header_title_margin_top">6dp</dimen>
    <dimen name="bestrom_header_title_margin_bottom">12dp</dimen>

    <!-- Device card -->
    <dimen name="bestrom_card_corner_radius">28dp</dimen>
    <dimen name="bestrom_card_padding_horizontal">18dp</dimen>
    <dimen name="bestrom_card_padding_vertical">16dp</dimen>
    <dimen name="bestrom_card_margin_top">12dp</dimen>
    <dimen name="bestrom_card_margin_bottom">9dp</dimen>
    <dimen name="bestrom_avatar_size">48dp</dimen>
    <dimen name="bestrom_avatar_dot_pitch">6dp</dimen>
    <dimen name="bestrom_avatar_dot_radius">1.2dp</dimen>

    <!-- Sub-pages -->
    <dimen name="bestrom_subpage_row_corner_radius">22dp</dimen>
    <dimen name="bestrom_subpage_ripple_padding">32dp</dimen>

    <style name="TextAppearance.Bestrom" parent="@style/TextAppearance"/>

    <style name="TextAppearance.Bestrom.Eyebrow">
        <item name="android:fontFamily">@*android:string/config_bodyFontFamily</item>
        <item name="android:textSize">@dimen/bestrom_eyebrow_text_size</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/bestrom_text_muted</item>
    </style>

    <style name="TextAppearance.Bestrom.PageTitle">
        <item name="android:fontFamily">doto</item>
        <item name="android:textSize">@dimen/bestrom_page_title_text_size</item>
        <item name="android:textColor">@color/bestrom_text_primary</item>
    </style>

    <style name="TextAppearance.Bestrom.PageTitle.Fallback">
        <item name="android:fontFamily">space-grotesk-bold</item>
    </style>

    <style name="TextAppearance.Bestrom.RowTitle">
        <item name="android:fontFamily">space-grotesk-semi-bold</item>
        <item name="android:textSize">@dimen/bestrom_row_title_text_size</item>
    </style>

    <style name="TextAppearance.Bestrom.RowTitle.Selected">
        <item name="android:fontFamily">space-grotesk-bold</item>
    </style>

    <style name="TextAppearance.Bestrom.RowSummary">
        <item name="android:fontFamily">space-grotesk</item>
        <item name="android:textSize">@dimen/bestrom_row_summary_text_size</item>
    </style>

    <style name="TextAppearance.Bestrom.RowValue">
        <item name="android:fontFamily">doto</item>
        <item name="android:textSize">@dimen/bestrom_row_value_text_size</item>
        <item name="android:textColor">@color/bestrom_row_value</item>
    </style>

    <style name="TextAppearance.Bestrom.Glyph">
        <item name="android:fontFamily">doto</item>
        <item name="android:textSize">@dimen/bestrom_glyph_text_size</item>
        <item name="android:textColor">@color/bestrom_text_primary</item>
    </style>

    <style name="TextAppearance.Bestrom.CardTitle">
        <item name="android:fontFamily">space-grotesk-semi-bold</item>
        <item name="android:textSize">@dimen/bestrom_row_title_text_size</item>
        <item name="android:textColor">@color/bestrom_text_primary</item>
    </style>

    <style name="TextAppearance.Bestrom.CardSummary">
        <item name="android:fontFamily">space-grotesk</item>
        <item name="android:textSize">@dimen/bestrom_row_summary_text_size</item>
        <item name="android:textColor">@color/bestrom_text_muted</item>
    </style>

    <!-- Child style: TextAppearance.SearchBar is applied at runtime by four locale and time zone
         pickers, so it must not be edited in place. -->
    <style name="TextAppearance.SearchBar.Bestrom" parent="@style/TextAppearance.SearchBar">
        <item name="android:textSize">@dimen/bestrom_search_bar_text_size</item>
        <item name="android:textColor">@color/bestrom_text_hint</item>
    </style>

    <!-- Sub-page rows. Each style overrides the background and nothing else, so icons, heights,
         paddings and gravity stay stock. -->
    <style name="BestromExpressivePreferenceTheme" parent="@style/ExpressivePreferenceTheme">
        <item name="expressivePreferenceRootLayoutStyle">@style/BestromExpressivePreferenceRootLayoutStyle</item>
    </style>

    <style name="BestromExpressivePreferenceRootLayoutStyle" parent="@style/ExpressivePreferenceRootLayoutStyle">
        <item name="android:background">@drawable/bestrom_subpage_row_background_stateful</item>
    </style>

    <style name="BestromExpressiveTwoTargetPreferenceTheme" parent="@style/ExpressiveTwoTargetPreferenceTheme">
        <item name="expressiveTwoTargetPreferenceRootStyle">@style/BestromExpressiveTwoTargetPreferenceRootStyle</item>
    </style>

    <style name="BestromExpressiveTwoTargetPreferenceRootStyle" parent="@style/ExpressiveTwoTargetPreferenceRootStyle">
        <item name="android:background">@drawable/bestrom_subpage_row_background_stateful</item>
    </style>

    <style name="BestromExpressiveSelectorWithWidgetPreferenceTheme" parent="@style/ExpressiveSelectorWithWidgetPreferenceTheme">
        <item name="expressiveSelectorWithWidgetPreferenceRootLayoutStyle">@style/BestromExpressiveSelectorWithWidgetPreferenceRootLayoutStyle</item>
    </style>

    <style name="BestromExpressiveSelectorWithWidgetPreferenceRootLayoutStyle" parent="@style/ExpressiveSelectorWithWidgetPreferenceRootLayoutStyle">
        <item name="android:background">@drawable/bestrom_subpage_row_background_stateful</item>
    </style>

</resources>
